/*
!/*.md
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/historico/
!/historico/**
historico/**/bin/
historico/**/obj/
!/scripts/
scripts/**/__pycache__/
scripts/**/*.pyc
!/xpz-*/
!/xpz-*/**
!/ptu-native/
!/ptu-native/**
ptu-native/**/bin/
ptu-native/**/obj/
# Agente opencode versionado (reviewer-ro): habilita SO o arquivo do agente,
# nao o runtime state do opencode. Cascata: re-inclui a pasta para o git descer,
# re-ignora o conteudo de cada nivel, e re-inclui apenas o arquivo do agente.
# (So `!/.opencode/`+`!/.opencode/agent/` nao basta: sem os `/.opencode/*` o
# runtime state — state.json, cache — ficaria trackable, ao contrario da intencao.)
!/.opencode/
/.opencode/*
!/.opencode/agent/
/.opencode/agent/*
!/.opencode/agent/reviewer-ro.md
