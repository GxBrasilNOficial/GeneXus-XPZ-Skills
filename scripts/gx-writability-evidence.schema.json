{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genexus-xpz-skills.local/schemas/gx-writability-evidence.schema.json",
  "title": "GeneXus transaction writability evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "ruleVersion", "identity", "basis", "coverage", "reasonCodes", "provenance", "evidenceSummary"],
  "properties": {
    "kind": {"const": "gx-writability-evidence"},
    "schemaVersion": {"const": 1},
    "ruleVersion": {"type": "string", "minLength": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "basis": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "enum": ["complete-in-model", "partial", "invalid"]},
    "reasonCodes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "attributePath": {"type": "string", "minLength": 1},
        "subtypeChain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "tableCandidates": {"type": "array", "items": {"$ref": "#/$defs/tableCandidate"}},
        "levelType": {"type": "string"},
        "associationStatus": {"type": "string", "enum": ["resolved-level-type-and-table-key", "table-binding-proposed", "table-binding-ambiguous", "table-key-unresolved", "key-identity-incomplete", "level-type-key-conflict"]},
        "relationAnalysis": {"$ref": "#/$defs/relationAnalysis"}
      }
    },
    "evidenceSummary": {"type": "string"}
  },
  "$defs": {
    "objectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "guid", "name", "path", "rootKind"],
      "properties": {
        "type": {"type": "string", "enum": ["Transaction", "Attribute"]},
        "guid": {"type": ["string", "null"], "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "rootKind": {"type": ["string", "null"], "enum": ["corpus", "delta", null]}
      }
    },
    "tableCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["guid", "name", "path", "keyGuids"],
      "properties": {
        "guid": {"type": ["string", "null"], "format": "uuid"},
        "name": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "keyGuids": {"type": "array", "items": {"type": ["string", "null"], "format": "uuid"}},
        "keyMismatch": {"type": "boolean"}
      }
    },
    "relationAnalysis": {
      "type": "object", "additionalProperties": false,
      "required": ["positives", "unknown", "indexedMember", "visitedTableGuids", "inspectedEdges", "maxDepth", "maxEdges"],
      "properties": {
        "positives": {"type": "array", "items": {"type": "string"}},
        "unknown": {"type": "array", "items": {"type": "string"}},
        "indexedMember": {"type": "boolean"},
        "visitedTableGuids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
        "inspectedEdges": {"type": "integer", "minimum": 0},
        "maxDepth": {"type": "integer", "minimum": 0},
        "maxEdges": {"type": "integer", "minimum": 0}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction", "partType", "level", "attribute"],
      "properties": {
        "transaction": {"$ref": "#/$defs/objectIdentity"},
        "partType": {"type": "string", "minLength": 1},
        "level": {
          "type": "object", "additionalProperties": false,
          "required": ["guid", "pathOrdinals"],
          "properties": {
            "guid": {"type": ["string", "null"], "format": "uuid"},
            "pathOrdinals": {"type": "array", "items": {"type": "integer", "minimum": 0}}
          }
        },
        "attribute": {"$ref": "#/$defs/objectIdentity"}
      }
    }
  }
}
