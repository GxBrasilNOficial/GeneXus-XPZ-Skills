{
  "schemaVersion": 1,
  "component": {
    "id": "jev",
    "displayName": "Jev/System One",
    "package": "@jkudish/jev-mcp",
    "version": "0.13.0",
    "tarballIntegrity": "sha512-0fFOAJwlsntMdHu4+t40H4BObOowfqVsZdMnU1tbqIHojbWotRia8quh8/SjEtwpC0CbemZF9TpBDbFNBhnRGw==",
    "distEntry": "dist/index.js",
