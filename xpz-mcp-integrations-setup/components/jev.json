      "requiredFields": [],
      "exclusiveEnvVars": [
        "TYPESAFE_API_KEY"
      ],
      "implemented": false,
      "preset": null,
      "endpointRule": "sdk"
    },
    "openrouter": {
      "secretEnvVar": "OPENROUTER_API_KEY",
      "publicEnvVars": [
        "JEV_OPENROUTER_BASE_URL"
      ],
      "requiredFields": [],
      "exclusiveEnvVars": [
        "OPENROUTER_API_KEY"
      ],
      "implemented": false,
      "preset": null,
      "endpointRule": "sdk"
    },
    "cloudflare": {
      "secretEnvVar": "CLOUDFLARE_API_TOKEN",
      "publicEnvVars": [
        "CLOUDFLARE_ACCOUNT_ID",
        "JEV_CLOUDFLARE_BASE_URL"
      ],
      "requiredFields": [
        "accountId"
      ],
      "exclusiveEnvVars": [
        "CLOUDFLARE_API_TOKEN",
        "JEV_CLOUDFLARE_API_TOKEN"
      ],
      "implemented": false,
      "preset": null,
      "endpointRule": "sdk"
    },
    "vercel": {
      "secretEnvVar": "AI_GATEWAY_API_KEY",
      "publicEnvVars": [],
      "requiredFields": [],
      "exclusiveEnvVars": [
        "AI_GATEWAY_API_KEY"
      ],
      "implemented": false,
      "preset": null,
      "endpointRule": "sdk"
    },
    "compatible": {
      "secretEnvVar": "JEV_API_KEY",
      "publicEnvVars": [
        "JEV_API_BASE_URL",
        "JEV_MCP_MODEL"
      ],
      "requiredFields": [
        "baseUrl",
        "model"
      ],
      "exclusiveEnvVars": [
        "JEV_API_KEY"
      ],
      "implemented": true,
      "preset": "command-code",
      "endpointRule": "explicit-url"
    }
  }
}
