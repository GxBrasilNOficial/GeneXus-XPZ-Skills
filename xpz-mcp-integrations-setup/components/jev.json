  "presets": {
    "command-code": {
      "displayName": "Command Code",
      "baseUrl": "https://api.commandcode.ai/provider/v1/systemone",
      "model": "typesafe/jev"
    }
  },
  "modes": {
    "typesafe": {
      "secretEnvVar": "TYPESAFE_API_KEY",
