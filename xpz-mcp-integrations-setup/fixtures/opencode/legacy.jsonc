{
  // Entrada manual legada mcp.jev, no formato medido em 2026-11-09.
  "mcp": {
    "jev": {
      "type": "local",
      "command": ["pwsh", "-NoProfile", "-File", "__LAUNCHER__"],
      "environment": {
        "JEV_PROVIDER": "compatible",
        "JEV_API_BASE_URL": "__BASE_URL__",
        "JEV_MCP_MODEL": "__MODEL__"
      },
      "enabled": true
    }
  }
}
