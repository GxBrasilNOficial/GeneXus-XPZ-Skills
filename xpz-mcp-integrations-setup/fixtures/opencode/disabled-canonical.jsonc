{
  // Entrada canonica desligada: reconhecida na leitura, nao e estado proprio da skill.
  "mcp": {
    "servers": {
      "jev": {
        "type": "local",
        "command": [
          "pwsh",
          "-NoProfile",
          "-File",
          "__LAUNCHER__"
        ],
        "environment": {
          "JEV_API_BASE_URL": "__BASE_URL__",
          "JEV_MCP_MODEL": "__MODEL__"
        },
        "disabled": true
      }
    }
  }
}
