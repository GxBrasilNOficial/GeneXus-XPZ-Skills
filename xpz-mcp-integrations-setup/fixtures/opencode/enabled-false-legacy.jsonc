{
  // Forma legada desligada por enabled:false (reconhecida, nao emitida).
  "mcp": {
    "jev": {
      "type": "local",
      "command": ["pwsh", "-NoProfile", "-File", "__LAUNCHER__"],
      "environment": {
        "JEV_API_BASE_URL": "__BASE_URL__",
        "JEV_MCP_MODEL": "__MODEL__"
      },
      "enabled": false
    }
  }
}
