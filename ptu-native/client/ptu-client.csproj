<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cliente NativeAOT (EXE). Compila o MESMO PtuCanon.cs que a DLL gerenciada (ptu-lib).
       As props que afetam canonicalizePath e entram no buildContractPin (InvariantGlobalization,
       TargetFramework, LangVersion) sao IDENTICAS as da DLL. PublishAot/OutputType/TrimMode
       diferem por natureza entre AOT e DLL e por isso ficam FORA do pin (plano, Passo B). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Optimize>true</Optimize>
    <AssemblyName>ptu-client</AssemblyName>
    <!-- Binario intencionalmente win-x64-only (design "Windows-x64-only"): o TFM e' net8.0 portavel
         (NAO net8.0-windows) porque TargetFramework entra no buildContractPin e mudar isso divergiria
         o pin da DLL (ptu-lib, net8.0). Logo os tipos ACL/SID disparam CA1416 (plataforma): esperado
         e silenciado. O csproj NAO entra no pin (so PtuCanon.cs + gerador + targets + 3 props). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PtuCanon.cs" />
  </ItemGroup>

  <!-- MutexAcl/MutexSecurity (guard mutex com ACL so-usuario) vivem em System.Threading.AccessControl,
       fora dos refs default do net8.0 (ao contrario de FileSecurity). PackageReference NAO entra no pin
       (so PtuCanon.cs + gerador + targets + 3 props). -->
  <ItemGroup>
    <PackageReference Include="System.Threading.AccessControl" Version="8.0.0" />
  </ItemGroup>

  <!-- Ultimo elemento antes de </Project>, depois das props (spec v12 §5i): gera e inclui BuildPin.g.cs. -->
  <Import Project="..\BuildPin.targets" />

</Project>
